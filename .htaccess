# Works on Hostinger (Apache / LiteSpeed). Safe no-ops if a module is missing.
DirectoryIndex index.php
Options -Indexes -MultiViews

# Clean URLs: hide the .php extension
<IfModule mod_rewrite.c>
  RewriteEngine On

  # /page.php -> /page (only for direct browser requests, avoids loops)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)\.php[\s?]
  RewriteRule ^(.+)\.php$ $1 [R=301,L]

  # /index -> /
  RewriteRule ^index$ ./ [R=301,L]

  # Friendly legal pages
  RewriteRule ^(terms|privacy)/?$ legal.php?p=$1 [L,QSA]

  # /page -> page.php when the file exists
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([^/]+)/?$ $1.php [L]
</IfModule>

# Keep subscriber data and config private
<FilesMatch "^(config\.php|\.htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
<FilesMatch "\.(csv|log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
